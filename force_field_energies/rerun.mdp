; Single-point energies of the scan structures (gmx mdrun -rerun).
; The molecule is much smaller than the 4 nm cut-off, so all its atom pairs are counted.
integrator               = md
nsteps                   = 0
continuation             = yes
cutoff-scheme            = Verlet
pbc                      = xyz
verlet-buffer-tolerance  = -1
rlist                    = 4.0
coulombtype              = Cut-off
rcoulomb                 = 4.0
vdwtype                  = Cut-off
rvdw                     = 4.0
constraints              = none
nstcalcenergy            = 1
nstenergy                = 1
